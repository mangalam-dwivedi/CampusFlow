# Public Supabase values (safe to expose to the browser through /api/config)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- AI (server-side only, never expose these in the browser) ---
# One key, or several separated by commas. Extra keys are rotated to spread the free quota.
GEMINI_API_KEY=AIza...,AIza...
# Optional: main and backup Gemini models (quota is tracked per model).
# Defaults are shown. If a model is ever retired, change the name here.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional backup provider used when Gemini is rate-limited (free key from console.groq.com)
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b (text only). Set a vision-capable Groq model to also back up image scans.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=

# Optional: max AI requests per student per hour when they use the shared key (default 30)
AI_USER_HOURLY_LIMIT=30
